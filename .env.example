# dashboard-service base URL. Defaults to the local dev port when unset.
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:4003

# Sentry (free tier). Leave the DSN empty to keep Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Verification only — NEVER set on Production. Enables /sentry-test and /api/sentry-test.
# NEXT_PUBLIC_SENTRY_TEST_ENABLED=true
# SENTRY_TEST_ENABLED=true
